# Frontend environment (Vite exposes only VITE_-prefixed variables to the client).

# API base path. Defaults to the same-origin `/api/v1`, which the Vite dev
# server proxies to the Express backend. Set an absolute URL only when the API
# is hosted on a different origin.
# VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
