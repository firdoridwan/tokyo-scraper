# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
API_PREFIX=/api

# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Storage ──────────────────────────────────────────────────────────────────
# Paths are resolved relative to the repository root.
DATA_DIR=data
DATABASE_PATH=data/database.sqlite

# memory | sqlite   ("sqlite" is not implemented yet)
PERSISTENCE_DRIVER=memory

# ── Scraper defaults (consumed once the engine is built) ─────────────────────
SCRAPER_HEADLESS=true
SCRAPER_CONCURRENCY=2
SCRAPER_REQUEST_DELAY_MS=1500
SCRAPER_NAVIGATION_TIMEOUT_MS=45000
SCRAPER_MAX_RETRIES=2

# ── Logging ──────────────────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
LOG_PRETTY=true
